# LLM Provider Keys (add the ones you use)
GOOGLE_API_KEY=your-google-api-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
ZAI_API_KEY=your-zai-api-key
HUGGINGFACE_API_KEY=your-huggingface-token

# Neo4j — Soros instance (default project DB; Konsep/SubKonsep ontology)
NEO4J_URI=neo4j+s://xxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password

# Neo4j — Yhoga instance (canonical Concept/Subtopic/Chapter/Grade ontology,
# extraction-v2-reviewed baseline). Used by pages/5_Completion.py when
# schema=yhoga and by experiments/{dump_lintas_buku,replay_completion}.py.
NEO4J_URI_YHOGA=neo4j+s://xxxxx.databases.neo4j.io
NEO4J_USERNAME_YHOGA=neo4j
NEO4J_PASSWORD_YHOGA=your-password
